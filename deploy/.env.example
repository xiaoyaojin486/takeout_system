# =====================================================================
#  外卖系统 · 部署环境变量模板（单机 Docker Compose 用）
#
#  说明：这份模板只是给人看的参考。实际部署用的 .env 由 Ansible 的
#  takeout-init role 从 group_vars 渲染生成到 {{ takeout_root }}/.env，
#  不需要手工复制本文件。
#
#  若你只想手工跑一遍 compose（不经 Ansible）：
#    cp deploy/.env.example deploy/.env   填好各项后
#    docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d
# =====================================================================

# ---- 应用镜像版本（决定 compose 引用 takeout-server:<版本> / takeout-nginx:<版本>）----
APP_VERSION=1.0.0

# ---- MySQL ----
MYSQL_DB=takeout
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---- MinIO（对象存储：商品图 / 用户头像）----
MINIO_ROOT_USER=takeoutadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD

# ---- JWT 双 token（至少 32 字符随机串）----
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars