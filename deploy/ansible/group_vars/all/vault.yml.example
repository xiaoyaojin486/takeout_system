---
# ===========================================================================
#  敏感变量（密钥）模板
#
#  用法：
#      cp group_vars/all/vault.yml.example group_vars/all/vault.yml
#      然后填入你自己的密码，务必执行一次加密：
#      ansible-vault encrypt group_vars/all/vault.yml
#      之后运行 playbook 需要带 --ask-vault-pass
#
#  ★ vault.yml（真实那份）已被 .gitignore 排除，不会误提交。
#    只有本模板 vault.yml.example 会进仓库，里面是占位值。
#
#  ★ 生成随机串：openssl rand -base64 32
# ===========================================================================

vault_mysql_root_password: "ChangeMe_Mysql_2026"
vault_redis_password: "ChangeMe_Redis_2026"
vault_minio_root_user: "takeoutadmin"
vault_minio_root_password: "ChangeMe_Minio_2026"
vault_jwt_secret: "change-me-to-a-random-string-at-least-32-chars"