# ===========================================================================
#  chrony 配置（由 Ansible base role 渲染，勿手改 —— 改完重跑 playbook 会被覆盖）
#
#  用途：给目标机做 NTP 时间同步。
#  为什么重要：JWT access token TTL 只有 30 分钟，系统时间一漂就会大量 401；
#             备份 systemd timer 与 Zabbix 触发器的时间窗同样依赖系统时间。
# ===========================================================================

# 国内 NTP 源（首次同步快），保留公共 pool 兜底
server ntp.aliyun.com iburst
server cn.pool.ntp.org iburst

# 允许在大偏差时一次性步进（首次部署机器时间可能差很远，必须允许跳变）
makestep 1.0 3

# 时间漂移记录到日志，方便排障
logdir /var/log/chrony