# 由 Ansible 渲染生成（deploy/ansible/roles/takeout-init/templates/env.j2）
# 改了 group_vars 里的值，重跑 playbook 即可刷新本文件。
# 密钥来自 vault.yml，本文件权限 0600。

# ---- 应用镜像版本（compose 用它拼 takeout-server:<版本> / takeout-nginx:<版本>）----
APP_VERSION={{ app_version }}

# ---- MySQL ----
MYSQL_DB={{ mysql_db }}
MYSQL_ROOT_PASSWORD={{ mysql_root_password }}

# ---- Redis ----
REDIS_PASSWORD={{ redis_password }}

# ---- MinIO ----
MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}
# 控制台绑定地址：默认 0.0.0.0（任意网卡）。想只让局域网访问，
# 在 group_vars/all/main.yml 里把 minio_console_bind 改成目标机内网 IP。
MINIO_CONSOLE_BIND={{ minio_console_bind }}

# ---- JWT 双 token ----
JWT_SECRET={{ jwt_secret }}