# ==========================================================
#  外卖系统 —— 环境变量模板
#  用法：复制为同目录下的 .env，然后填入你自己的密码。
#      Windows:  copy .env.example .env
#      Mac/Linux: cp .env.example .env
#  格式：KEY=VALUE，值不要加引号，行首 # 为注释。
# ==========================================================

# ---------------------- MySQL ----------------------
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=takeout
MYSQL_USERNAME=root

# ---------------------- Redis（可选）---------------------
CACHE_TYPE=local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------- JWT 双 token ----------------------
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=7d

# ---------------------- 建表与演示数据 ----------------------
SQL_INIT_MODE=always

# ---------------------- 文件上传 ----------------------
UPLOAD_PATH=./upload