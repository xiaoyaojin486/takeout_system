# =====================================================================
#  外卖系统 .gitignore
#  第一条规则最重要：.env 里是 MySQL 密码等敏感配置，绝不能提交。
#  只提交 .env.example 模板（里面是占位值，不含真实密码）。
# =====================================================================

# ---------- 密钥与环境变量（绝对不提交）----------
.env
.env.local
.env.*.local
*.local

# ---------- 构建产物 ----------
target/
dist/
dist-ssr/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ---------- 依赖 ----------
node_modules/

# ---------- 运行时数据 ----------
# 图片上传目录属于运行时数据，不是源码
backend/upload/
logs/
*.log

# ---------- IDE 与系统文件 ----------
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# ---------- 临时目录 ----------
.tmp/

# ---------- Ansible ----------
# 真实 inventory 含服务器 IP / 私钥路径，只提交 inventory.ini.example 模板
deploy/ansible/inventory.ini
# 真实密钥文件只保留 vault.yml.example 模板；vault.yml 不提交，
# 避免填了真实密码后忘了 ansible-vault 加密就被 commit 上去
deploy/ansible/group_vars/all/vault.yml